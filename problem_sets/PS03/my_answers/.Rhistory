library(GGally)
# Input the data.
observed <- matrix(c(14, 6, 7, 7, 7, 1), nrow = 2, byrow = TRUE)
rownames(observed) <- c("Upper class", "Lower class")
colnames(observed) <- c("Not stopped", "Bribe", "Warning")
print(observed)
# Calculate each row total, each column total and the grand total.
t_upper <- observed[1, 1] + observed[1, 2] + observed[1, 3]
t_lower <- observed[2, 1] + observed[2, 2] + observed[2, 3]
t_not_stopped <- observed[1, 1] + observed[2, 1]
t_bribe <- observed[1, 2] + observed[2, 2]
t_warning <- observed[1, 3] + observed[2, 3]
t <- t_upper + t_lower
t_observed <- rbind(
cbind(observed, Total = c(t_upper, t_lower)),
Total = c(t_not_stopped, t_bribe, t_warning, t))
print(t_observed)
# Expected counts: row total times column total, divided by t (42).
E11 <- (t_upper * t_not_stopped) / t
E12 <- (t_upper * t_bribe) / t
E13 <- (t_upper * t_warning) / t
E21 <- (t_lower * t_not_stopped) / t
E22 <- (t_lower * t_bribe) / t
E23 <- (t_lower * t_warning) / t
expected <- matrix(c(E11, E12, E13, E21, E22, E23),
nrow = 2, byrow = TRUE, dimnames = dimnames(observed))
print(round(expected, 4)) # Rounded to 4 decimal points.
# Subtract the expected count from the observed count in each cell.
D11 <- observed[1, 1] - E11
D12 <- observed[1, 2] - E12
D13 <- observed[1, 3] - E13
D21 <- observed[2, 1] - E21
D22 <- observed[2, 2] - E22
D23 <- observed[2, 3] - E23
differences <- matrix(c(D11, D12, D13, D21, D22, D23),
nrow = 2, byrow = TRUE,
dimnames = dimnames(observed))
print(round(differences, 4)) # Rounded to 4 decimal points.
# Square each of the six differences.
S11 <- D11^2
S12 <- D12^2
S13 <- D13^2
S21 <- D21^2
S22 <- D22^2
S23 <- D23^2
squared_differences <- matrix(c(S11, S12, S13, S21, S22, S23),
nrow = 2, byrow = TRUE,
dimnames = dimnames(observed))
print(round(squared_differences, 4)) # Rounded to 4 decimal points.
# Divide each squared difference by its own expected count.
C11 <- S11 / E11
C12 <- S12 / E12
C13 <- S13 / E13
C21 <- S21 / E21
C22 <- S22 / E22
C23 <- S23 / E23
div_squared_differences <- matrix(c(C11, C12, C13, C21, C22, C23),
nrow = 2, byrow = TRUE,
dimnames = dimnames(observed))
print(round(div_squared_differences, 4)) # Rounded to 4 decimal points.
# Add the six values.
chi_squared <- C11 + C12 + C13 + C21 + C22 + C23
cat("Therefore, the chi-squared test statistic is:", chi_squared)
df_chi <- (2 - 1) * (3 - 1)
p_chi <- pchisq(chi_squared, df = df_chi, lower.tail = FALSE)
cat("The p-value is:", p_chi)
# Calculate each row proportion and each column proportion.
r1 <- t_upper / t
r2 <- t_lower / t
c1 <- t_not_stopped / t
c2 <- t_bribe / t
c3 <- t_warning / t
print(c(r1 = r1, r2 = r2, c1 = c1, c2 = c2, c3 = c3))
# Calculate the denominator.
SE11 <- (E11 * (1 - r1) * (1 - c1))^0.5
SE12 <- (E12 * (1 - r1) * (1 - c2))^0.5
SE13 <- (E13 * (1 - r1) * (1 - c3))^0.5
SE21 <- (E21 * (1 - r2) * (1 - c1))^0.5
SE22 <- (E22 * (1 - r2) * (1 - c2))^0.5
SE23 <- (E23 * (1 - r2) * (1 - c3))^0.5
mat_se <- matrix(c(SE11, SE12, SE13, SE21, SE22, SE23),
nrow = 2, byrow = TRUE, dimnames = dimnames(observed))
print(round(mat_se, 4)) # Rounded to 4 decimal points.
# Calculate each residual using that cell's observed count and denominator.
z11 <- (observed[1, 1] - E11) / SE11
z12 <- (observed[1, 2] - E12) / SE12
z13 <- (observed[1, 3] - E13) / SE13
z21 <- (observed[2, 1] - E21) / SE21
z22 <- (observed[2, 2] - E22) / SE22
z23 <- (observed[2, 3] - E23) / SE23
standardized_residuals <- matrix(c(z11, z12, z13, z21, z22, z23),
nrow = 2, byrow = TRUE,
dimnames = dimnames(observed))
print(round(standardized_residuals, 3)) # Rounded to 4 decimal points.
# Import the data.
women <- read.csv(paste0("https://raw.githubusercontent.com/",
"kosukeimai/qss/master/PREDICTION/women.csv"))
print(dim(women))
print(sum(is.na(women)))
print(table(women$reserved))
# Estimate the bivariate regression.
water_model <- lm(water ~ reserved, data = women)
summary(water_model)
# Reproduce the two-sided slope test from the regression output.
beta_1 <- coef(water_model)["reserved"]
se_beta_1 <- coef(summary(water_model))["reserved", "Std. Error"]
t_slope <- unname(beta_1 / se_beta_1)
df_slope <- df.residual(water_model)
p_slope <- 2 * pt(abs(t_slope), df = df_slope, lower.tail = FALSE)
print(c(t = t_slope, df = df_slope, p_value = p_slope))
# Calculate the 95% confidence interval.
t_critical <- qt(0.975, df = df_slope)
ci_slope <- unname(beta_1) + c(-1, 1) * t_critical * se_beta_1
names(ci_slope) <- c("Lower", "Upper")
print(ci_slope)
# Check the CI using confint.
print(confint(water_model, "reserved", level = 0.95))
# Plot for OLS
library(ggplot2)
plot_data <- data.frame(reserved = c(0, 1))
plot_data <- cbind(plot_data, predict(water_model, plot_data, interval = "confidence"))
water_plot <- ggplot(plot_data, aes(factor(reserved), fit, ymin = lwr, ymax = upr)) +
geom_errorbar(width = 0.12, colour = "steelblue") +
geom_point(size = 3, colour = "steelblue") +
scale_x_discrete(labels = c("Not reserved", "Reserved")) +
labs(title = "Drinking-water facilities by reservation status",
subtitle = "OLS fitted means with conventional 95% confidence intervals",
x = "Reservation status", y = "Mean drinking-water facilities") +
theme_classic()
print(water_plot)
ggsave("PS02_figures/PS02_group_means.pdf", water_plot, width = 7, height = 5)
mean_water <- tapply(women$water, women$reserved, mean)
print(mean_water)
mean_difference <- unname(mean_water["1"] - mean_water["0"])
print(mean_difference)
predicted_water <- predict(water_model,
newdata = data.frame(reserved = c(0, 1)))
print(predicted_water)
mean_water <- tapply(women$water, women$reserved, mean)
print(mean_water)
mean_difference <- unname(mean_water["1"] - mean_water["0"])
print(mean_difference)
predicted_water <- predict(water_model,
newdata = data.frame(reserved = c(0, 1)))
print(predicted_water)
# Import the data and check the three variables.
incumbents <- read.csv("incumbents_subset.csv", row.names = 1)
incumbents <- incumbents[c("voteshare", "difflog", "presvote")]
print(dim(incumbents))
print(colSums(is.na(incumbents)))
summary(incumbents)
# Do a lm for voteshare on difflog.
vote_spending <- lm(voteshare ~ difflog, data = incumbents)
summary(vote_spending)
# Calculate 95% confidence limits for the fitted mean.
library(ggplot2)
dir.create("Figures", showWarnings = FALSE) # Create folder to store graphics.
spending_gap <- seq(min(incumbents$difflog), max(incumbents$difflog),
length.out = 200)
vote_grid <- data.frame(difflog = spending_gap)
vote_grid <- cbind(vote_grid, predict(vote_spending, vote_grid,
interval = "confidence", level = 0.95))
# Plot the observations, fitted line and confidence limits.
vote_spending_plot <- ggplot(vote_grid, aes(x = difflog)) +
geom_point(data = incumbents, aes(y = voteshare),
size = 0.8, alpha = 0.28, colour = "grey35") +
geom_line(aes(y = lwr), colour = "red4", linetype = "dashed") +
geom_line(aes(y = upr), colour = "red4", linetype = "dashed") +
geom_line(aes(y = fit), colour = "steelblue2", linewidth = 0.7) +
scale_y_continuous(labels = scales::label_percent(accuracy = 1)) +
labs(title = "Incumbent vote share and campaign spending",
subtitle = "Fitted mean in blue with dashed 95% confidence limits",
x = "difflog (Log incumbent spending minus log challenger spending)",
y = "voteshare (Incumbent vote share)") +
theme_classic(base_size = 12)
ggsave("Figures/Q1_vote_spending.pdf", vote_spending_plot,
width = 7, height = 4)
### 1.3) Save the residuals of the model in a separate object.
vote_resid <- resid(vote_spending)
first_election <- c(observed = incumbents$voteshare[1],
fitted = unname(fitted(vote_spending)[1]),
residual = unname(vote_resid[1]))
print(round(first_election, 6)) # Rounded to 6 decimals.
# Get the coefficients for the prediction equation.
round(coef(vote_spending), 6) # Rounded to 6 decimals.
# Regress presvote on difflog.
pres_spending <- lm(presvote ~ difflog, data = incumbents)
summary(pres_spending)
# Calculate 95% confidence limits for the fitted mean.
pres_grid <- data.frame(difflog = spending_gap)
pres_grid <- cbind(pres_grid, predict(pres_spending, pres_grid,
interval = "confidence", level = 0.95))
# Plot the observations, fitted line and confidence limits.
pres_spending_plot <- ggplot(pres_grid, aes(x = difflog)) +
geom_point(data = incumbents, aes(y = presvote),
size = 0.8, alpha = 0.28, colour = "grey35") +
geom_line(aes(y = lwr), colour = "red4", linetype = "dashed") +
geom_line(aes(y = upr), colour = "red4", linetype = "dashed") +
geom_line(aes(y = fit), colour = "steelblue2", linewidth = 0.7) +
scale_y_continuous(labels = scales::label_percent(accuracy = 1)) +
labs(title = "Presidential vote share and campaign spending",
subtitle = "Fitted mean in blue with dashed 95% confidence limits",
x = "difflog (Log incumbent spending minus log challenger spending)",
y = "presvote (Presidential vote share)") +
theme_classic(base_size = 12)
ggsave("Figures/Q2_pres_spending.pdf", pres_spending_plot,
width = 7, height = 4)
### 2.3) Save the residuals of the model in a separate object.
pres_resid <- resid(pres_spending)
first_election <- c(observed = incumbents$presvote[1],
fitted = unname(fitted(pres_spending)[1]),
residual = unname(pres_resid[1]))
print(round(first_election, 6)) # Rounded to 6 decimals.
# Get the coefficients for the prediction equation.
round(coef(pres_spending), 6) # Rounded to 6 decimals.
# Regress voteshare on presvote.
vote_pres <- lm(voteshare ~ presvote, data = incumbents)
summary(vote_pres)
# Calculate 95% confidence limits for the fitted mean.
pres_share <- seq(min(incumbents$presvote), max(incumbents$presvote),
length.out = 200)
support_grid <- data.frame(presvote = pres_share)
support_grid <- cbind(support_grid, predict(vote_pres, support_grid,
interval = "confidence", level = 0.95))
# Plot the observations, fitted line and confidence limits.
vote_pres_plot <- ggplot(support_grid, aes(x = presvote)) +
geom_point(data = incumbents, aes(y = voteshare),
size = 0.8, alpha = 0.28, colour = "grey35") +
geom_line(aes(y = lwr), colour = "red4", linetype = "dashed") +
geom_line(aes(y = upr), colour = "red4", linetype = "dashed") +
geom_line(aes(y = fit), colour = "steelblue2", linewidth = 0.7) +
scale_x_continuous(labels = scales::label_percent(accuracy = 1)) +
scale_y_continuous(labels = scales::label_percent(accuracy = 1)) +
labs(title = "Incumbent and presidential vote shares",
subtitle = "Fitted mean in blue with dashed 95% confidence limits",
x = "presvote (Presidential vote share)",
y = "voteshare (Incumbent vote share)") +
theme_classic(base_size = 12)
ggsave("Figures/Q3_vote_pres.pdf", vote_pres_plot,
width = 7, height = 4)
### 3.3) Write the prediction equation.
round(coef(vote_pres), 6) # Rounded to 6 decimals.
# Regress vote_resid on pres_resid.
residual_data <- data.frame(vote_resid, pres_resid)
resid_model <- lm(vote_resid ~ pres_resid, data = residual_data)
summary(resid_model)
# Calculate 95% confidence limits for the fitted mean.
pres_gap <- seq(min(residual_data$pres_resid), max(residual_data$pres_resid),
length.out = 200)
resid_grid <- data.frame(pres_resid = pres_gap)
resid_grid <- cbind(resid_grid, predict(resid_model, resid_grid,
interval = "confidence", level = 0.95))
# Plot the observations, fitted line and confidence limits.
resid_plot <- ggplot(resid_grid, aes(x = pres_resid)) +
geom_point(data = residual_data, aes(y = vote_resid),
size = 0.8, alpha = 0.28, colour = "grey35") +
geom_line(aes(y = lwr), colour = "red4", linetype = "dashed") +
geom_line(aes(y = upr), colour = "red4", linetype = "dashed") +
geom_line(aes(y = fit), colour = "steelblue2", linewidth = 0.7) +
# To read the residuals in percentage points, we multiply the axis labels by 100.
scale_x_continuous(labels = scales::label_number(scale = 100)) +
scale_y_continuous(labels = scales::label_number(scale = 100)) +
labs(title = "Added-variable plot for incumbent vote share",
subtitle = "Fitted mean in blue with dashed 95% confidence limits",
x = "Presidential vote-share residual (percentage points)",
y = "Incumbent vote-share residual (percentage points)") +
theme_classic(base_size = 12)
ggsave("Figures/Q4_added_variable.pdf", resid_plot,
width = 7, height = 4)
### 4.3) Write the prediction equation.
round(coef(resid_model), 6) # Rounded to 6 decimals.
# Regress incumbent vote share on both predictors.
full_model <- lm(voteshare ~ difflog + presvote, data = incumbents)
summary(full_model)
### 5.2) Write the prediction equation.
round(coef(full_model), 6) # Rounded to 6 decimals.
### 5.3) What is it in this output that is identical to the output in Question 4? Why do you think this is the case?
slopes <- c(Q4 = unname(coef(resid_model)["pres_resid"]),
Q5 = unname(coef(full_model)["presvote"]))
print(slopes, digits = 10)
print(all.equal(unname(resid(resid_model)), unname(resid(full_model))))
se <- c(Q4 = coef(summary(resid_model))["pres_resid", "Std. Error"],
Q5 = coef(summary(full_model))["presvote", "Std. Error"])
print(se, digits = 8)
# Read and summarise the election data.
library(stargazer)
incumbents <- read.csv("incumbents_subset.csv", row.names = 1)
incumbents <- incumbents[c("voteshare", "difflog", "presvote")]
descriptive <- rbind(Elections = nrow(incumbents),
Missing = colSums(is.na(incumbents)),
sapply(incumbents, summary))
stargazer(t(descriptive),  # Create the descriptive statistics table.
summary = FALSE, digits = 4, float = FALSE)
# Fit incumbent vote share on the log spending gap.
vote_spending <- lm(voteshare ~ difflog, data = incumbents)
stargazer(vote_spending, digits = 6, single.row = TRUE,  # Create regression table.
report = "vc*st", omit.stat = c("ser", "f"), float = FALSE)
