library(ggplot2)
expenditure$Region_name <- factor(expenditure$Region, # Set Region as factors.
levels = 1:4,
labels = c("Northeast", "North Central", "South", "West"))
View(expenditure)
expenditure$Region_name <- factor(expenditure$Region, # Set Region as factors as a new variable.
levels = 1:4,
labels = c("Northeast", "North Central", "South", "West"))
View(expenditure)
# tapply() finds the mean separately for each region.
region_means <- tapply(expenditure$Y, expenditure$Region_name, mean)
print(round(region_means, 2))
# tapply() finds the mean separately for each region.
region_means <- tapply(expenditure$Y, expenditure$Region_name, mean)
print(round(region_means, 2))
pdf("PS01_figures/spending_by_region.pdf", width = 7, height = 4)
boxplot(Y ~ Region_name, data = expenditure,
col = "lightgrey", xlab = "Region",
ylab = "Per capita expenditure (Y)")
points(1:4, region_means, col = "red", pch = 18)
legend("topleft", legend = "Mean", col = "red", pch = 18,
bty = "n")
dev.off()
