income_plot <- ggplot(expenditure, aes(x = X1, y = Y)) +
geom_point(colour = "blue", size = 2) +
labs(x = "Per capita personal income (X1)",
y = "Per capita expenditure (Y)") +
theme_minimal()
ggsave("PS01_figures/spending_and_income.pdf", plot = income_plot,
width = 7, height = 4)
