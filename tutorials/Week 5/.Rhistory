# You can edit this path if you move the course dataset.
data_file <- Sys.getenv(
"WEEK5_DATA_FILE",
unset = paste0(
"/Users/diegobm/Desktop/ARCHIVOS/TRINITY/",
"MT Applied Statistics I/StatsI_2026/datasets/fictional_data.csv"
)
)
output_dir <- Sys.getenv(
"WEEK5_OUTPUT_DIR", unset = file.path(getwd(), "Week5_results")
)
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)
df <- read.csv(data_file)
print(df)
str(df)
print(summary(df))
# edu = years of education; income = monthly income in euros,
# using the units shown in the tutorial. cap is not used in these exercises.
stopifnot(all(c("edu", "income") %in% names(df)))
stopifnot(is.numeric(df$edu), is.numeric(df$income))
stopifnot(all(complete.cases(df[, c("edu", "income")])))
n <- nrow(df)                    # 19 complete observations
alpha <- 0.05                    # Significance level for both tests
# Calculate Pearson's correlation.
r <- cor(df$edu, df$income, method = "pearson")
print(r)                        # 0.8785034: strong positive linear association
# Create a scatter plot, add the correlation, use clear labels and save as PDF.
pdf(file.path(output_dir, "01_correlation_scatter.pdf"), width = 7.2, height = 4.8)
plot(df$edu, df$income,
pch = 19, col = "#176B80", las = 1,
xlab = "Education (years)", ylab = "Monthly income (euros)",
main = "Education and monthly income")
legend("topleft", legend = sprintf("Pearson r = %.3f; n = %d", r, n),
bty = "n")
invisible(dev.off())
# Run the t-test for the population correlation coefficient.
# Use cor.test(), not t.test(): t.test() tests means, not correlation.
correlation_test <- cor.test(df$edu, df$income,
method = "pearson", alternative = "two.sided")
print(correlation_test)
print(correlation_test$p.value)  # 7.520470e-07
# linear relationship without dominating outliers. The exact Pearson t-test
# assumes bivariate normality. Sampling independence cannot be checked here.
# The scatter plot suggests a positive, approximately linear association.
# With n = 19, normality and unusual observations deserve attention.
#
# Step 2: Hypotheses
# H0: rho = 0 (no population linear correlation).
# HA: rho != 0 (a population linear correlation exists).
#
# Step 3: Test statistic
t_correlation <- r * sqrt((n - 2) / (1 - r^2))
degrees_freedom <- n - 2
print(c(t = t_correlation, df = degrees_freedom)) # t = 7.5819; df = 17
#
# Step 4: Two-sided p-value
p_correlation_manual <- 2 * pt(-abs(t_correlation), df = degrees_freedom)
print(p_correlation_manual)      # 0.0000007520
#
# Step 5: Conclusion
# Reject H0 at 5% (also at 1%). There is evidence of a positive linear
# association between education and income under the test assumptions.
# This does not establish that education causes higher income.
print(correlation_test$conf.int) # 95% CI for rho: [0.7060, 0.9526]
# Question: Is there a relationship between education and income?
# Population model: income_i = beta0 + beta1 * edu_i + error_i.
model <- lm(income ~ edu, data = df)
model_summary <- summary(model)
print(model_summary)
# Conduct the two-sided t-test for the slope and check its p-value.
slope_results <- coef(model_summary)["edu", ]
print(slope_results)
p_slope <- slope_results["Pr(>|t|)"]
print(p_slope)
# Create a residual plot. The Q-Q plot is an additional normality diagnostic.
pdf(file.path(output_dir, "02_residual_diagnostics.pdf"), width = 9, height = 4.5)
par(mfrow = c(1, 2), mar = c(4.5, 4.5, 3, 1))
plot(fitted(model), resid(model), pch = 19, col = "#176B80", las = 1,
xlab = "Predicted monthly income (euros)",
ylab = "Residual (euros)", main = "Residuals versus fitted values")
abline(h = 0, lty = 2, col = "grey40")
text(fitted(model)[10], resid(model)[10], labels = "Row 10",
pos = 3, cex = 0.8)
qqnorm(resid(model), pch = 19, col = "#176B80",
main = "Normal Q-Q plot", ylab = "Residual (euros)")
qqline(resid(model), col = "#B85A37", lwd = 2)
