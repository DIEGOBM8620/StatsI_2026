# create vector y
y <- c(0, 4, 4, 5, 7, 10)
# (1) find sum of y using the built-in R function
sum(y)
# (2) find mean of y using your "own" function
# now do the same thing, but faster using the built-in R function
sum(y)/length(y)
mean(y)
# (3) find sum of demeaned values
y-mean(y)
# (3) find sum of demeaned values
y - mean(y)
# (3) find sum of demeaned values
y - mean(y)
# (4) calculate sum of squared error
sqrt(y - mean(y))
# (4) calculate sum of squared error
sd_y <- y - mean(y)
# (4) calculate sum of squared error
(y - mean(y))^2
sd(y)
# (4) calculate sum of squared error
deviations <- y - mean(y)
sum(deviations)
# create vector y
y <- c(0, 4, 4, 5, 7, 10)
# create vector y
y <- c(0, 4, 4, 5, 7, 10)
# (1) find sum of y using the built-in R function
sum(y)
# (2) find mean of y using your "own" function
sum(y)/length(y)
# now do the same thing, but faster using the built-in R function
mean(y)
# (3) find sum of demeaned values
y - mean(y)
# (4) calculate sum of squared error
deviations <- y - mean(y)
sum(deviations)
sum_deviations <- sum(deviations)
# (4) calculate sum of squared error
deviations <- y - mean(y)
squared_error <- sum(deviations^2)
squared_error
sd(y)
squared_error
variance <- squared_error / (leght(y) - 1)
variance <- squared_error / (length(y) - 1)
variance
